.DS_Store
node_modules/
dist/
*.log
.omo

# graphify knowledge graph: commit graphify-out/ (the map); cost.json and cache/ are local-only.
graphify-out/cost.json
graphify-out/cache/

# Local environment and Worker secrets
.env
.env.*
!.env.example
.dev.vars*
!.dev.vars.example
*.local

# Xcode / Swift
.build/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/

# Private release/signing material
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.provisionprofile

# Wrangler local state
.wrangler/

# Turborepo
.turbo/
.gstack/

# Agent / GSD working files (private to user-agent collaboration)
/AGENTS.md
/Roadmap.md
/State.md
/handoff.js
/debug.md

# Planning artifacts
.planning/

# Scratchpad / local working drafts and backups
/scratchpad/
# Local debugging notes kept alongside a live investigation, not part of the record.
/Debugging/
# Verbatim sub-agent session transcripts. Useful while the work is open, far too
# large and too duplicative of the docs to belong in history.
/kimi-export-session_*.md
/codex-export-session_*.md
/cursor-export-session_*.md

# graphify build artifacts (keep only clean deliverables)
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/wiki/

# Vite writes a timestamped temp config next to the real one on each dev run
*.timestamp-*.mjs
